[Unit]
Description=Linux Cleaner quarantine retention purge
# Mutating runs share one lock: wait for a catch-up cleanup started at the same time.
After=linux-cleaner-clean.service

[Service]
Type=oneshot
# Tune older-than:DAYS here (RUNBOOK default 30; aggressive tier: 7).
ExecStart=/usr/bin/env cleaner --purge-sessions older-than:30 --force
SyslogIdentifier=linux-cleaner
# Idle priority keeps a catch-up or periodic run from slowing the desktop session.
Nice=19
IOSchedulingClass=idle
# Oneshot units default to no start timeout: bound a hung run so later timer slots still fire.
TimeoutStartSec=2h
