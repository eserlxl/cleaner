[Unit]
Description=Linux Cleaner JSON monitoring dry-run

[Service]
Type=oneshot
# Explicit flags keep inherited execution settings in preview mode.
# Quarantine-disk companion (human or cron): cleaner --list-sessions --json
ExecStart=/usr/bin/env cleaner --quiet --dry-run --json
SyslogIdentifier=linux-cleaner
EnvironmentFile=-%h/.config/linux-cleaner/monitor.env
