# Safe-tier defaults for systemd EnvironmentFile=-
LINUX_CLEANER_FORCE=1
LINUX_CLEANER_TRASH=1
LINUX_CLEANER_RISK=safe
#LINUX_CLEANER_QUIET=1
#LINUX_CLEANER_ONLY_TARGET=NPM
#LINUX_CLEANER_LOG=$HOME/.cache/linux-cleaner/operations.log
# Retention age is set in examples/systemd/linux-cleaner-retention.service (older-than:30).
