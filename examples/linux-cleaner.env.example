# Copy to ~/.config/linux-cleaner/env (see RUNBOOK.md systemd section).
# Safe-tier defaults for systemd EnvironmentFile=-
# linux-cleaner-clean.service passes only --clean --force, so LINUX_CLEANER_TRASH
# and LINUX_CLEANER_RISK in this file apply to the timer.
LINUX_CLEANER_FORCE=1
# Enabling LINUX_CLEANER_TRASH makes the daily timer quarantine instead of delete.
# linux-cleaner-retention.timer must then be enabled too.
# LINUX_CLEANER_TRASH=1
LINUX_CLEANER_RISK=safe
# Raising LINUX_CLEANER_RISK above safe makes the unattended deletion of medium
# targets (e.g. build directories) irreversible.
#LINUX_CLEANER_QUIET=1
#LINUX_CLEANER_DEBUG=1
# Use an absolute config path here: EnvironmentFile does not expand $HOME,
# and the cleaner uses LINUX_CLEANER_CONFIG literally. Unset uses normal discovery.
#LINUX_CLEANER_CONFIG=/absolute/path/to/cleaner.conf
#LINUX_CLEANER_ONLY_TARGET=NPM
#LINUX_CLEANER_EXCLUDE_TARGET=Chromium
#LINUX_CLEANER_LOG=$HOME/.cache/linux-cleaner/ops.log
# JSON is for dry-run/inventory only; leave unset for the cleanup service.
# Use linux-cleaner-monitor.service for scheduled JSON previews.
#LINUX_CLEANER_EXCLUDE=.git,*.log
# High-risk: only for outside-$HOME package-cache targets (pacman/apt/dnf/zypper/apk).
# The shipped package-cache targets are medium risk, so they
# also need LINUX_CLEANER_RISK=medium above; under RISK=safe this has no effect.
#LINUX_CLEANER_ALLOW_OUTSIDE_HOME=1
# Never schedule by default — danger-tier bypass.
#LINUX_CLEANER_YES_DANGER=1
# Retention age is set in examples/systemd/linux-cleaner-retention.service (older-than:30).
