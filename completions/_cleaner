#compdef cleaner cleaner.sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Zsh tab completion for cleaner / cleaner.sh.

_cleaner() {
  local -a sessions
  sessions=("$HOME/.cache/linux-cleaner/quarantine/"*(ND/:t))
  _arguments \
    '(-c --config)'{-c,--config}'[Path to a configuration file (default search order: XDG user config, then /etc/linux-cleaner/cleaner.conf, then cleaner.conf beside the script)]:file:_files' \
    '(-d --dry-run)'{-d,--dry-run}'[Calculate and display potential space savings without deleting anything (default)]' \
    '--clean[Perform cleanup with a summary confirmation prompt]' \
    '(-i --interactive)'{-i,--interactive}'[Prompt for confirmation before cleaning each target]' \
    '(-f --force)'{-f,--force}'[Perform cleaning immediately without any confirmation prompts (except danger level)]' \
    '--yes-danger[Bypass manual confirmation prompt for danger risk targets]' \
    '(-t --trash)'{-t,--trash}'[Move files to quarantine instead of permanent deletion]' \
    '(-r --risk)'{-r,--risk}'[Max risk level to clean: safe, medium, danger (default: safe)]:risk level:(safe medium danger)' \
    '(-e --exclude)'{-e,--exclude}'[Comma-separated glob patterns to exclude (Warning: Incorrect patterns can affect deletion semantics or exclude everything)]:patterns:' \
    '--list-sessions[List quarantine sessions (read-only) and exit]' \
    '--report[Print the saved last cleanup report and exit]' \
    '--list-targets[List configured cleanup targets (read-only) and exit]' \
    '--check-config[Validate the configuration file and exit (no disk analysis)]' \
    '--init-config[Copy the active config to your user config path (never overwrites)]' \
    '--doctor[Check the runtime environment a cleanup depends on (read-only) and exit]' \
    '--restore[Restore files from quarantine session (latest or timestamp)]:session:{compadd -- latest "${sessions[@]}"}' \
    '--hold-session[Protect a quarantine session (latest or timestamp) from every purge and --trash-keep-days retention]:session:{compadd -- latest "${sessions[@]}"}' \
    '--release-session[Remove a session hold so normal purge and retention apply again]:session:{compadd -- latest "${sessions[@]}"}' \
    '--only[With --restore: restore only targets whose original path contains PATTERN; the rest stay quarantined]:pattern:' \
    '--only-exact[With --restore: match a literal original path from session inventory; excludes --only]:path:' \
    '--only-target[With cleanup or --list-targets: select config targets whose NAME contains PATTERN]:pattern:' \
    '--exclude-target[With cleanup or --list-targets: skip config targets whose NAME contains PATTERN]:pattern:' \
    '--only-path[With cleanup or --list-targets: select ordinary targets at/below an existing absolute path; excludes action:* rows (env: LINUX_CLEANER_ONLY_PATH)]:file:_files' \
    '--exclude-path[With cleanup or --list-targets: skip targets at, below, or containing an existing absolute path (env: LINUX_CLEANER_EXCLUDE_PATH)]:file:_files' \
    '--lock-wait[With mutating runs: wait up to 0..2147483647 seconds for the lock (default: 0; env: LINUX_CLEANER_LOCK_WAIT)]:seconds:' \
    '--min-reclaim[With cleanup: skip the run when the planned reclaim is below SIZE (e.g. 500M, 2G)]:size:' \
    '--min-free[With cleanup: skip the run when the home filesystem already has at least SIZE free (e.g. 10G)]:size:' \
    '--min-age[With cleanup: raise every ordinary target'\''s age threshold to at least DAYS days; skips action:* rows (env: LINUX_CLEANER_MIN_AGE)]:days:' \
    '--action-timeout[With cleanup: stop each action:* command after SECONDS seconds and count it failed (0: no limit; env: LINUX_CLEANER_ACTION_TIMEOUT)]:seconds:' \
    '--trash-keep-days[With cleanup: purge quarantine sessions older than DAYS days after cleaning]:days:' \
    '--purge-sessions[Permanently delete quarantine session(s) to reclaim space (latest, all, older-than:DAYS, max-size:SIZE, keep-latest:N, or timestamp). Irreversible]:session:{compadd -- latest all "${sessions[@]}"; compadd -S "" -- older-than\: max-size\: keep-latest\:}' \
    '--allow-outside-home[Deprecated no-op; targets outside HOME are always allowed]' \
    '--log[Append an operation log (opt-in, off by default; kept under your HOME)]::file:_files' \
    '(-q --quiet)'{-q,--quiet}'[Suppress per-target status lines; keep errors, totals, and final summary]' \
    '--debug[Show per-target FOUND, CLEAN and PROTECTED lines (suppressed by default; overridden by --quiet)]' \
    '--show-matches[List eligible paths under each ordinary target in a text dry run (overridden by --quiet)]' \
    '--exit-code[Dry-run only: exit 2 if cleanup would run, 0 if it would skip (errors: 1)]' \
    '--notify[With cleanup: send a desktop notification summarizing the result (no-op on dry-run; env: LINUX_CLEANER_NOTIFY)]' \
    '--fail-fast[With cleanup: stop after the first failed target and skip inline retention (env: LINUX_CLEANER_FAIL_FAST)]' \
    '--json[Emit machine-readable JSON (--dry-run summary, --list-targets inventory, --list-sessions inventory, or --report summary)]' \
    '(- *)'{-h,--help}'[Display this help message and exit]' \
    '(- *)'{-V,--version}'[Print the tool version and exit]'
}

_cleaner "$@"
