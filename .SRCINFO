pkgbase = linux-cleaner
	pkgdesc = Safe, configuration-driven cleaner for caches and temporary files
	pkgver = 1.6.0
	pkgrel = 1
	url = https://github.com/eserlxl/cleaner
	install = linux-cleaner.install
	arch = any
	license = GPL-3.0-or-later
	depends = bash>=4.4
	depends = findutils
	depends = coreutils
	optdepends = pacman-contrib: paccache-based package-cache actions
	optdepends = libnotify: desktop notifications for --notify
	optdepends = git: skip cleanup targets that hold git-tracked files
	backup = etc/linux-cleaner/cleaner.conf
	source = linux-cleaner-1.6.0.tar.gz::https://github.com/eserlxl/cleaner/archive/refs/tags/v1.6.0.tar.gz
	sha256sums = SKIP

pkgname = linux-cleaner
